{
  "name": "simple-hackathon-ops",
  "private": true,
  "description": "Open-source kit for running a hackathon: an application form (static site + Google Apps Script) and an MCP server that manages the GitHub organization.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forreal03/SimpleHackathon-ops-mcp.git"
  }
}

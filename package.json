{
  "name": "hackathon-ops-mcp",
  "version": "0.1.0",
  "description": "MCP server for running hackathons on GitHub: team assignment from a sheet, per-team repositories, reviewer access, submission freeze and third-party app review.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hackathon-ops-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "events/example",
    "policies",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hackathon",
    "github",
    "github-app",
    "google-sheets"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "google-auth-library": "^11.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}

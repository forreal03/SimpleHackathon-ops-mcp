# Folder that contains events/ and policies/ (defaults to the working directory)
HACKATHON_OPS_HOME=/path/to/hackathon-ops-mcp

# GitHub App (recommended)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/your-app.private-key.pem
# or the key itself, with \n for newlines:
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...

# Fallback for trying things out on a test org (fine-grained or classic PAT)
# GITHUB_TOKEN=github_pat_...

# Google service account with Viewer access to the roster spreadsheet
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# or inline JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Name written to the audit log
HACKATHON_OPS_OPERATOR=your-name
